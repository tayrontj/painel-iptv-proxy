{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/videlis-api.cjs"
    }
  },
  "rewrites": [
    { "source": "/api/:videlis_api_path*", "destination": "/api?__videlis_api_path=:videlis_api_path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
